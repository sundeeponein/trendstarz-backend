# Node dependencies
/node_modules/

# Build output
/dist/
/assets/local-images/

# IDE and OS files
/.vscode/
/.idea/
.DS_Store
startup.log

# Environment files (keep example template tracked)
.env
.env.*
!.env.production.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage reports
/coverage/

# Misc
*.tgz

# Optional: ignore generated files
*.js
*.js.map
*.tsbuildinfo
# ...but hand-written ops scripts here are not generated output — keep them tracked
!scripts/*.js

# Optional: ignore test output
/test-results/
test-results.json
auth_test_results.json
auth_test.log

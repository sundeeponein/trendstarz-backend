# ============================================================
# TrendStarz Backend — Production Environment Variables
# Copy this file to .env and fill in all required values.
# NEVER commit .env to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Use a dedicated production MongoDB cluster (NOT the dev cluster)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/trendstarz?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────────────
# Must be at least 32 chars. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate-a-strong-random-64-char-hex>

# ── Server ───────────────────────────────────────────────────
PORT=3000

# ── Email ────────────────────────────────────────────────────
# Supported providers: brevo | resend | ses
# Brevo is the default if EMAIL_PROVIDER is omitted.
EMAIL_PROVIDER=brevo

# Brevo (https://brevo.com) — set if EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
# Verified sender address for outgoing emails (must be a domain verified in Brevo)
BREVO_FROM=noreply@trendstarz.in

# Resend (https://resend.com) — set only if EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=noreply@trendstarz.in

# AWS SES — set only if EMAIL_PROVIDER=ses
# AWS_SES_REGION=ap-south-1
# AWS_SES_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
# AWS_SES_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AWS_SES_FROM=noreply@trendstarz.in

# ── App URLs (used in email CTAs) ────────────────────────────
# Must match the actual production frontend domain, no trailing slash
FRONTEND_URL=https://trendstarz.in

# Email address that receives brand UTR payment alerts and admin notifications
ADMIN_EMAIL=admin@trendstarz.in

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes)
# Defaults to: https://trendstarz.in,https://www.trendstarz.in,http://localhost:4200
CORS_ORIGINS=https://trendstarz.in,https://www.trendstarz.in

# ── Cloudinary (image uploads) ───────────────────────────────
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# ── Push Notifications (VAPID) ───────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=<your-vapid-public-key>
VAPID_PRIVATE_KEY=<your-vapid-private-key>
VAPID_SUBJECT=mailto:support@trendstarz.in

# ── Razorpay subscriptions + campaign pay-in ────────────────
# Public key id can also be mirrored into the frontend build as `razorpayKeyId`.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# ── RazorpayX automatic payouts ─────────────────────────────
AUTO_PAYOUT_ENABLED=true
RAZORPAYX_KEY_ID=rzp_xxxxxxxxxxxx
RAZORPAYX_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAYX_ACCOUNT_NUMBER=1234567890
RAZORPAYX_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx
